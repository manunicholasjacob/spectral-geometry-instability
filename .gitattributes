# Auto detect text files and perform LF normalization
* text=auto

# Jupyter notebooks
*.ipynb linguist-language=Jupyter

# Python files
*.py text diff=python

# Documentation
*.md text
*.txt text
*.rst text

# Config files
*.yaml text
*.yml text
*.json text

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
